#!/bin/sh
# Hiveton H5000M 首次启动个性化设置

#---------- 系统 ----------
uci -q batch <<-EOF
	set system.@system[0].hostname='Hiveton_H5000M'
	set system.@system[0].timezone='CST-8'
	set system.@system[0].zonename='Asia/Shanghai'
	set system.@system[0].ttylogin='0'
	set system.@system[0].log_size='128'
	set system.@system[0].urandom_seed='0'
	delete system.ntp
	set system.ntp=timeserver
	set system.ntp.enabled='1'
	set system.ntp.enable_server='0'
	add_list system.ntp.server='ntp.tencent.com'
	add_list system.ntp.server='ntp.aliyun.com'
	add_list system.ntp.server='ntp.ntsc.ac.cn'
	add_list system.ntp.server='ntp.tuna.tsinghua.edu.cn'
	commit system
EOF

#---------- root 默认密码 ----------
# 密码：admin（MD5-crypt 哈希，必须用单引号，双引号会被 shell 展开成空密码）
# 换密码用：openssl passwd -1 你的新密码
sed -i 's|^root:[^:]*:|root:$1$Op3nWrtX$l7bDHUU8J8QiMrMHTsaL51:|' /etc/shadow

#---------- 无线 ----------
# mtwifi 是 MTK 闭源驱动，/etc/config/wireless 的结构与 mac80211 完全不同，
# 按 band 分频段设 SSID 的那套写法在这棵树上不适用，故整段停用。
# 编译期已由 Scripts/Settings.sh 把 mtwifi.sh 里的默认加密方式改成
# psk2+ccmp 并写入默认密码，SSID 保持源码默认。
# 刷机后需要改名/改信道，请用 LuCI 的「MTK WiFi 配置」(luci-app-mtwifi-cfg)。

exit 0

